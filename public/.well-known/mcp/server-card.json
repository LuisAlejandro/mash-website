{
  "$schema": "https://static.modelcontextprotocol.io/schemas/mcp-server-card/v1.json",
  "version": "1.0",
  "protocolVersion": "2025-11-25",
  "serverInfo": {
    "name": "mash-website",
    "title": "Mash",
    "version": "1.2.0"
  },
  "description": "Read-only; no authentication or transactional tools.",
  "documentationUrl": "https://letsma.sh/agents.md",
  "transport": {
    "type": "streamable-http",
    "endpoint": "https://letsma.sh/api/mcp"
  },
  "capabilities": {
    "tools": {}
  },
  "authentication": {
    "required": false,
    "schemes": []
  },
  "tools": [
    {
      "name": "get_site_discovery",
      "title": "Get site discovery",
      "description": "Return canonical public surface URLs for this deployment.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "search_docs",
      "title": "Search docs",
      "description": "Search documentation titles and descriptions locally.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_docs_page",
      "title": "Get docs page",
      "description": "Return a documentation page as Markdown; pass a slug or /docs/ path.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    }
  ]
}
