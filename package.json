{
  "name": "mash-website",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-agent-skills.mjs && node scripts/generate-mcp-card.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "next typegen && tsc --noEmit",
    "docs:check": "node scripts/check-docs.mjs",
    "blog:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-blog.mjs",
    "markdown:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-markdown.mjs",
    "agent-readiness:smoke": "bash scripts/agent-readiness-smoke.sh",
    "typegen": "next typegen",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "feed": "^6.0.0",
    "fumadocs-core": "^16.17.9",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-ui": "^16.17.9",
    "isomorphic-dompurify": "^4.6.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "eslint-plugin-react": "github:jsx-eslint/eslint-plugin-react#b73f1108346bffb5566d17ae4cac8b13fe2b7834"
  }
}
