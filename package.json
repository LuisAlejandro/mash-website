{
  "name": "mash-website",
  "version": "1.3.3",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "predev": "node scripts/generate-mcp-card.mjs",
    "prebuild": "node scripts/generate-agent-skills.mjs && node scripts/generate-mcp-card.mjs",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "next typegen && tsc --noEmit",
    "docs:check": "node scripts/check-docs.mjs",
    "blog:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-blog.mjs",
    "markdown:check": "FEATURE_BLOG=1 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-markdown.mjs",
    "optimize-images": "node scripts/strip-image-metadata.mjs",
    "browsers:update": "update-browserslist-db",
    "typegen": "next typegen",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "node scripts/migrate-deploy.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@neondatabase/serverless": "^1.1.0",
    "@next/third-parties": "^16.4.5",
    "@sentry/nextjs": "^11.10.0",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "feed": "^6.0.0",
    "fumadocs-core": "^16.17.9",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-ui": "^16.17.9",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "update-browserslist-db": "^1.3.4"
  },
  "overrides": {
    "eslint-plugin-react": "github:jsx-eslint/eslint-plugin-react#b73f1108346bffb5566d17ae4cac8b13fe2b7834"
  },
  "browserslist": [
    "last 2 versions and not dead",
    "> 1%"
  ]
}
