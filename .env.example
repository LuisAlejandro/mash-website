# Mash website environment.
#
# Everything here is optional. With no .env at all the site builds and serves
# exactly as it did before the blog existed: /blog and /admin return 404, and
# no database or auth code is bundled.
#
# Copy to .env for local work. Never commit real values.

# --- Blog module ------------------------------------------------------------
# Both must be "1" to turn the blog on. The server flag gates routes, APIs, and
# module loading; the NEXT_PUBLIC mirror is inlined into the client bundle and
# drives navigation only. Setting just one leaves the site inconsistent.
FEATURE_BLOG=0
NEXT_PUBLIC_FEATURE_BLOG=0

# --- Database (required when FEATURE_BLOG=1) --------------------------------
# Neon gives two connection strings and both are needed:
#   DATABASE_URL          pooled, used for public blog reads over HTTP
#   DATABASE_URL_UNPOOLED direct, used for migrations and the auth pool,
#                         which needs transactions the HTTP driver cannot run
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Admin auth (required when FEATURE_BLOG=1) ------------------------------
# BETTER_AUTH_SECRET: any long random string, e.g. `openssl rand -base64 32`
# BETTER_AUTH_URL:    the site origin, e.g. http://localhost:3000 in dev
# GitHub OAuth app callback: {BETTER_AUTH_URL}/api/auth/callback/github
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated addresses allowed to manage posts, matched case-insensitively
# against the GitHub account's email. Empty denies everyone, including the
# first person to sign in, so set this before expecting admin access.
ADMIN_EMAIL_ALLOWLIST=

# --- CDN purge (required to publish when FEATURE_BLOG=1) --------------------
# Publishing clears Next's cache and then the CDN. Without these the admin
# publish action fails rather than reporting success while the CDN still
# serves the old page.
NETLIFY_PURGE_TOKEN=
NETLIFY_SITE_ID=

# Optional second purge target, for deployments that front Netlify with
# Cloudflare. Leaving these unset is not an error.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Shared secret for POST /api/revalidate, sent as `Authorization: Bearer ...`.
# Unset denies every caller.
REVALIDATE_SECRET=

# --- Error reporting (optional) ---------------------------------------------
# Sentry stays completely inert unless a DSN is set: no SDK is loaded, nothing
# is sent, and a build with no token skips source-map upload. The public DSN is
# what the browser SDK reads, so both are needed for client errors.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Label shown in Sentry, e.g. "production" or "preview". There are two because
# the server and the browser read different variables: the server reads
# SENTRY_ENVIRONMENT, the browser can only see NEXT_PUBLIC_SENTRY_ENVIRONMENT.
# Set both, or server and client events in the same project will disagree.
# Unset, both fall back to NODE_ENV.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Only needed to upload source maps and create releases at build time.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Analytics (optional) ---------------------------------------------------
# Both are consent-gated: the scripts load only after a visitor chooses
# "Allow analytics". Leaving the ID unset disables that tracker entirely, and
# with both unset no banner is shown and no third-party script is loaded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
